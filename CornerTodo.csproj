<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <ProjectGuid>{162C3664-05BF-4E0A-8713-D515CC24A126}</ProjectGuid>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <Import Project="CornerTodo.Build.props" />
  <PropertyGroup>
    <CornerTodoGeneratedIcon>$([System.IO.Path]::Combine('$(IntermediateOutputPath)', 'CornerTodo.ico'))</CornerTodoGeneratedIcon>
    <ApplicationIcon Condition="'$(ApplicationIcon)' == ''">$(CornerTodoGeneratedIcon)</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <None Include="@(CornerTodoPublicFile)" />
    <None Include="@(CornerTodoTestSource)" />
    <None Include="@(CornerTodoTestSuite->'%(Runner)')" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="BeforeBuild">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="&quot;$(WINDIR)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build\Common.ps1&quot;" />
    <Exec Condition="'$(ApplicationIcon)' == '$(CornerTodoGeneratedIcon)'" WorkingDirectory="$(MSBuildProjectDirectory)" Command="&quot;$(WINDIR)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build\Generate-Icon.ps1&quot; -OutputPath &quot;$(ApplicationIcon)&quot;" />
  </Target>
  <Target Name="AfterBuild">
    <Copy SourceFiles="$(ApplicationIcon)" DestinationFiles="$(TargetDir)$(AssemblyName).ico" SkipUnchangedFiles="true" />
  </Target>
  <!-- Reads evaluated project declarations without requiring the developer targeting pack. -->
  <Target Name="DescribeBuild">
    <Message Importance="high" Text="Framework=$(TargetFrameworkVersion); Language=$(LangVersion); Platform=$(PlatformTarget); Prefer32Bit=$(Prefer32Bit); Entry=$(StartupObject); Manifest=$(ApplicationManifest); Config=$(AppConfig)" />
    <Message Importance="high" Text="Compile=%(Compile.Identity)" />
    <Message Importance="high" Text="Reference=%(Reference.Identity); FrameworkFile=%(Reference.FrameworkFile)" />
  </Target>
</Project>
