<?xml version="1.0" encoding="utf-8"?>
<!-- Literal, repository-relative paths only. Both MSBuild and PowerShell read this file. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>5</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CornerTodo</AssemblyName>
    <RootNamespace>CornerTodo</RootNamespace>
    <StartupObject>CornerTodo.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppConfig>CornerTodo.exe.config</AppConfig>
    <AssemblyInfoFile>src/App/AssemblyInfo.cs</AssemblyInfoFile>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/UI/AppearanceEditor.cs" />
    <Compile Include="src/App/ApplicationComposition.cs" />
    <Compile Include="src/App/ApplicationController.cs" />
    <Compile Include="src/App/ApplicationInteraction.cs" />
    <Compile Include="src/UI/AppearanceSettings.cs"><TestGroups>Store;Session</TestGroups></Compile>
    <Compile Include="src/App/AssemblyInfo.cs" />
    <Compile Include="src/Windows/DesktopHost.cs" />
    <Compile Include="src/Windows/DesktopAttachmentController.cs" />
    <Compile Include="src/App/Diagnostics.cs" />
    <Compile Include="src/UI/GrowthLayout.cs"><TestGroups>Growth</TestGroups></Compile>
    <Compile Include="src/Tasks/ITodoStore.cs"><TestGroups>Store;Session</TestGroups></Compile>
    <Compile Include="src/App/LaunchOptions.cs" />
    <Compile Include="src/UI/MainWindow.cs" />
    <Compile Include="src/Tasks/Models.cs"><TestGroups>Store;Session</TestGroups></Compile>
    <Compile Include="src/UI/PanelController.cs" />
    <Compile Include="src/App/Program.cs" />
    <Compile Include="src/App/SingleInstanceSession.cs" />
    <Compile Include="src/Windows/StartupManager.cs" />
    <Compile Include="src/Tasks/TaskDraft.cs"><TestGroups>Session</TestGroups></Compile>
    <Compile Include="src/UI/TaskEditor.cs" />
    <Compile Include="src/UI/TaskListView.cs" />
    <Compile Include="src/UI/Theme.cs" />
    <Compile Include="src/Tasks/TodoSession.cs"><TestGroups>Session</TestGroups></Compile>
    <Compile Include="src/Tasks/TodoStateCopy.cs"><TestGroups>Session</TestGroups></Compile>
    <Compile Include="src/Tasks/TodoStore.cs"><TestGroups>Store;Session</TestGroups></Compile>
    <Compile Include="src/UI/TodoPanelView.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System"><FrameworkFile>System.dll</FrameworkFile></Reference>
    <Reference Include="System.Core"><FrameworkFile>System.Core.dll</FrameworkFile></Reference>
    <Reference Include="System.Web.Extensions"><FrameworkFile>System.Web.Extensions.dll</FrameworkFile></Reference>
    <Reference Include="System.Xaml"><FrameworkFile>System.Xaml.dll</FrameworkFile></Reference>
    <Reference Include="System.Windows.Forms"><FrameworkFile>System.Windows.Forms.dll</FrameworkFile></Reference>
    <Reference Include="System.Drawing"><FrameworkFile>System.Drawing.dll</FrameworkFile></Reference>
    <Reference Include="WindowsBase"><FrameworkFile>WPF/WindowsBase.dll</FrameworkFile></Reference>
    <Reference Include="PresentationCore"><FrameworkFile>WPF/PresentationCore.dll</FrameworkFile></Reference>
    <Reference Include="PresentationFramework"><FrameworkFile>WPF/PresentationFramework.dll</FrameworkFile></Reference>
  </ItemGroup>
  <ItemGroup>
    <CornerTodoTestSuite Include="Store"><SourceGroup>Store</SourceGroup><EntryPoint>StoreTests</EntryPoint><Runner>tests/Run-StoreTests.ps1</Runner></CornerTodoTestSuite>
    <CornerTodoTestSuite Include="Session"><SourceGroup>Session</SourceGroup><EntryPoint>SessionTests</EntryPoint><Runner>tests/Run-SessionTests.ps1</Runner></CornerTodoTestSuite>
    <CornerTodoTestSuite Include="Growth"><SourceGroup>Growth</SourceGroup><EntryPoint>GrowthLayoutTests</EntryPoint><Runner>tests/Run-GrowthLayoutTests.ps1</Runner></CornerTodoTestSuite>
    <CornerTodoTestSuite Include="Panel"><SourceGroup>All</SourceGroup><EntryPoint>PanelControllerTests</EntryPoint><Runner>tests/Run-PanelTests.ps1</Runner></CornerTodoTestSuite>
    <CornerTodoTestSuite Include="View"><SourceGroup>All</SourceGroup><EntryPoint>ViewTests</EntryPoint><Runner>tests/Run-ViewTests.ps1</Runner></CornerTodoTestSuite>
    <CornerTodoTestSuite Include="OffscreenUi"><SourceGroup>All</SourceGroup><EntryPoint>OffscreenUiTests</EntryPoint><Runner>tests/Run-OffscreenUiTests.ps1</Runner><OutputArgument>tests/visual-qa</OutputArgument></CornerTodoTestSuite>
    <CornerTodoTestSuite Include="AppearanceUi"><SourceGroup>All</SourceGroup><EntryPoint>AppearanceUiTests</EntryPoint><Runner>tests/Run-AppearanceUiTests.ps1</Runner><OutputArgument>tests/appearance-qa</OutputArgument></CornerTodoTestSuite>
    <CornerTodoTestSuite Include="Startup"><SourceGroup>All</SourceGroup><EntryPoint>StartupTests</EntryPoint><Runner>tests/Run-StartupTests.ps1</Runner></CornerTodoTestSuite>
    <CornerTodoTestSuite Include="Instance"><SourceGroup>All</SourceGroup><EntryPoint>SingleInstanceTests</EntryPoint><Runner>tests/Run-InstanceTests.ps1</Runner></CornerTodoTestSuite>
    <CornerTodoTestSuite Include="Desktop"><SourceGroup>All</SourceGroup><EntryPoint>DesktopAttachmentTests</EntryPoint><Runner>tests/Run-DesktopTests.ps1</Runner></CornerTodoTestSuite>
    <CornerTodoTestSuite Include="Lifecycle"><SourceGroup>All</SourceGroup><EntryPoint>LifecycleTests</EntryPoint><Runner>tests/Run-LifecycleTests.ps1</Runner></CornerTodoTestSuite>
    <CornerTodoTestSource Include="tests/StoreTests.cs"><Suite>Store</Suite></CornerTodoTestSource>
    <CornerTodoTestSource Include="tests/SessionTests.cs"><Suite>Session</Suite></CornerTodoTestSource>
    <CornerTodoTestSource Include="tests/GrowthLayoutTests.cs"><Suite>Growth</Suite></CornerTodoTestSource>
    <CornerTodoTestSource Include="tests/PanelControllerTests.cs"><Suite>Panel</Suite></CornerTodoTestSource>
    <CornerTodoTestSource Include="tests/ViewTests.cs"><Suite>View</Suite></CornerTodoTestSource>
    <CornerTodoTestSource Include="tests/TaskEditorTests.cs"><Suite>View</Suite></CornerTodoTestSource>
    <CornerTodoTestSource Include="tests/OffscreenUiTests.cs"><Suite>OffscreenUi</Suite></CornerTodoTestSource>
    <CornerTodoTestSource Include="tests/AppearanceUiTests.cs"><Suite>AppearanceUi</Suite></CornerTodoTestSource>
    <CornerTodoTestSource Include="tests/StartupTests.cs"><Suite>Startup</Suite></CornerTodoTestSource>
    <CornerTodoTestSource Include="tests/LaunchOptionsTests.cs"><Suite>Startup</Suite></CornerTodoTestSource>
    <CornerTodoTestSource Include="tests/StartupUiTests.cs"><Suite>Startup</Suite></CornerTodoTestSource>
    <CornerTodoTestSource Include="tests/SingleInstanceTests.cs"><Suite>Instance</Suite></CornerTodoTestSource>
    <CornerTodoTestSource Include="tests/DesktopAttachmentTests.cs"><Suite>Desktop</Suite></CornerTodoTestSource>
    <CornerTodoTestSource Include="tests/LifecycleTests.cs"><Suite>Lifecycle</Suite></CornerTodoTestSource>
    <CornerTodoTestSource Include="tests/LifecycleUiTests.cs"><Suite>Lifecycle</Suite></CornerTodoTestSource>
  </ItemGroup>
  <ItemGroup>
    <CornerTodoPublicFile Include=".gitignore" />
    <CornerTodoPublicFile Include=".gitattributes" />
    <CornerTodoPublicFile Include="LICENSE" />
    <CornerTodoPublicFile Include="VERSION" />
    <CornerTodoPublicFile Include="README.md" />
    <CornerTodoPublicFile Include="CHANGELOG.md" />
    <CornerTodoPublicFile Include="Build.ps1" />
    <CornerTodoPublicFile Include="Package.ps1" />
    <CornerTodoPublicFile Include="CornerTodo.Build.props" />
    <CornerTodoPublicFile Include="CornerTodo.csproj" />
    <CornerTodoPublicFile Include="CornerTodo.sln" />
    <CornerTodoPublicFile Include="app.manifest" />
    <CornerTodoPublicFile Include="CornerTodo.exe.config" />
    <CornerTodoPublicFile Include="build/Common.ps1" />
    <CornerTodoPublicFile Include="build/Generate-Icon.ps1" />
    <CornerTodoPublicFile Include="tests/Run-BuildTests.ps1" />
    <CornerTodoPublicFile Include="tests/Inspect-Windows.ps1" />
    <CornerTodoPublicFile Include="docs/DEVELOPMENT.md" />
    <CornerTodoPublicFile Include="docs/PUBLISHING.md" />
    <CornerTodoPublicFile Include="docs/PORTABLE-README.txt" />
    <CornerTodoPublicFile Include="docs/RELEASE_NOTES.md" />
    <CornerTodoPublicFile Include="docs/STARTUP.md" />
    <CornerTodoPublicFile Include="docs/images/normal.png" />
    <CornerTodoPublicFile Include="docs/images/urgent.png" />
    <CornerTodoPublicFile Include="docs/images/overdue.png" />
    <CornerTodoPublicFile Include="docs/images/notes-editor.png" />
    <CornerTodoPublicFile Include="docs/images/dark.png" />
    <CornerTodoPublicFile Include="docs/images/appearance-editor.png" />
  </ItemGroup>
</Project>
